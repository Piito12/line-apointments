# Copy to .env.local and fill in the values. Never commit .env.local.
# คัดลอกเป็น .env.local แล้วกรอกค่า ห้าม commit .env.local
# Details / รายละเอียด: docs/configuration.md · docs/configuration.th.md

# --- LINE (required / จำเป็น) ---------------------------------------------
# LINE Developers Console → channel → Basic settings → Channel secret
LINE_CHANNEL_SECRET=
# LINE Developers Console → channel → Messaging API → Channel access token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=

# --- Google Calendar (recommended / แนะนำ) ---------------------------------
# Service account JSON key on ONE line: jq -c . key.json
# JSON key ของ service account เป็นบรรทัดเดียว
GOOGLE_SERVICE_ACCOUNT_KEY=
# xxxxxxxx@group.calendar.google.com
GOOGLE_CALENDAR_ID=

# --- Shop data (optional / ไม่บังคับ) ---------------------------------------
# Google Sheet ID from https://docs.google.com/spreadsheets/d/<Sheet ID>/edit
# Empty = made-up demo clinic / เว้นว่าง = ใช้คลินิกสมมติ
CONFIG_SHEET_ID=

# --- AI model --------------------------------------------------------------
# Required for deploys (the Deploy button asks for both) / ตอน deploy ต้องมี
# anthropic | openai | gateway   (gateway = Vercel AI Gateway, many providers with one key)
AI_PROVIDER=
# The key for that provider / key ของเจ้านั้น
AI_API_KEY=
# Optional: model within the provider, e.g. claude-haiku-5.5 · gpt-5.6-sol · anthropic/claude-sonnet-5 (gateway)
# ไม่บังคับ: รุ่นโมเดลภายใน provider
AI_MODEL=
# Local only: leave AI_PROVIDER empty to use a ChatGPT subscription (/login in the TUI)
# Older names still work when AI_PROVIDER is empty: ANTHROPIC_API_KEY · OPENAI_API_KEY · AI_GATEWAY_API_KEY
# เฉพาะ local: เว้น AI_PROVIDER ว่างเพื่อใช้ ChatGPT subscription / ชื่อแบบเดิมยังใช้ได้
